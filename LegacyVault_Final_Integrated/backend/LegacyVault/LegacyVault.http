@LegacyVault_HostAddress = https://localhost:7015
@token = PASTE_JWT_TOKEN_HERE
@assetId = PASTE_ASSET_ID_HERE
@willId = PASTE_WILL_ID_HERE
@willAssetId = PASTE_WILL_ASSET_ID_HERE
@beneficiaryAccountId = PASTE_SEARCHED_ACCOUNT_ID_HERE
@beneficiaryDesignationId = PASTE_BENEFICIARY_DESIGNATION_ID_HERE
@executorAccountId = PASTE_EXECUTOR_ACCOUNT_ID_HERE

### =========================================================
### 0. HEALTH
### =========================================================

GET {{LegacyVault_HostAddress}}/api/health
Accept: application/json

###

GET {{LegacyVault_HostAddress}}/api/health/database
Accept: application/json

### =========================================================
### 1. LOGIN FIRST -> COPY token INTO @token
### Seed account password: Demo@123
### =========================================================

POST {{LegacyVault_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "kiet.user@legacyvault.demo",
  "password": "Demo@123",
  "rememberMe": false
}

### =========================================================
### 2. ACCOUNT / BENEFICIARY SEARCH
### =========================================================

GET {{LegacyVault_HostAddress}}/api/accounts/me
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{LegacyVault_HostAddress}}/api/accounts/search?email=minhanh.user@legacyvault.demo
Authorization: Bearer {{token}}
Accept: application/json

### Phone note:
### + in query string must be URL encoded as %2B.
GET {{LegacyVault_HostAddress}}/api/accounts/search?phone=%2B84901000002
Authorization: Bearer {{token}}
Accept: application/json

### =========================================================
### 3. KIET - ASSET + ENCRYPTION
### Before this section, configure Encryption:KekBase64 in User Secrets.
### =========================================================

### Create encrypted online-account Asset.
### This matches the current demo MockExternalAccounts seed.
POST {{LegacyVault_HostAddress}}/api/assets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Demo Gmail Account",
  "description": "Encrypted Gmail credential for LegacyVault demo",
  "assetType": "ACCOUNT",
  "provider": "GMAIL",
  "secretData": {
    "username": "demo.gmail@gmail.com",
    "password": "External@123"
  }
}

### Copy returned Id into @assetId.

###

GET {{LegacyVault_HostAddress}}/api/assets
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{LegacyVault_HostAddress}}/api/assets/{{assetId}}
Authorization: Bearer {{token}}
Accept: application/json

### Authorized decrypt demo.
GET {{LegacyVault_HostAddress}}/api/assets/{{assetId}}/secret
Authorization: Bearer {{token}}
Accept: application/json

### Basic mock-provider verification.
POST {{LegacyVault_HostAddress}}/api/assets/{{assetId}}/verify
Authorization: Bearer {{token}}
Accept: application/json

### Update metadata only; null secretData keeps encrypted secret.
PUT {{LegacyVault_HostAddress}}/api/assets/{{assetId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Demo Gmail Account Updated",
  "description": "Metadata updated without replacing secret",
  "assetType": "ACCOUNT",
  "provider": "GMAIL",
  "secretData": null
}

### =========================================================
### 4. CUONG - WILL FLOW
### Create DRAFT -> Asset -> Beneficiary -> Assignment
### -> Executor -> DMS -> Review -> Submit
### =========================================================

POST {{LegacyVault_HostAddress}}/api/wills
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "My Digital Legacy",
  "description": "LegacyVault demo will"
}

### Copy returned Id into @willId.

###

GET {{LegacyVault_HostAddress}}/api/wills
Authorization: Bearer {{token}}
Accept: application/json

### Add owned Asset to Will.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/assets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assetId": "{{assetId}}"
}

### Copy returned willAssetId into @willAssetId.

### Linked beneficiary:
### First use /api/accounts/search and copy returned Id into @beneficiaryAccountId.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/beneficiaries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "beneficiaryAccountId": "{{beneficiaryAccountId}}",
  "relationship": "Sibling"
}

### Copy returned Id into @beneficiaryDesignationId.

### Alternative manual beneficiary for a person not using LegacyVault.
### Current V1 DB schema requires Email for BeneficiaryDesignations.
# POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/beneficiaries
# Authorization: Bearer {{token}}
# Content-Type: application/json
#
# {
#   "beneficiaryAccountId": null,
#   "fullName": "External Beneficiary",
#   "email": "external.beneficiary@example.com",
#   "phone": "+84909999999",
#   "relationship": "Friend"
# }

### Assign selected WillAsset to selected Beneficiary.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "willAssetId": "{{willAssetId}}",
  "beneficiaryDesignationId": "{{beneficiaryDesignationId}}"
}

### List seeded verified Executors.
GET {{LegacyVault_HostAddress}}/api/executors
Authorization: Bearer {{token}}
Accept: application/json

### Copy one accountId into @executorAccountId.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/executor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "executorAccountId": "{{executorAccountId}}"
}

### Configure DMS.
PUT {{LegacyVault_HostAddress}}/api/wills/{{willId}}/dms
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "enabled": true,
  "checkInIntervalDays": 30,
  "reminderBeforeDays": 3,
  "maxMissedCheckIns": 3
}

### Review before submit.
GET {{LegacyVault_HostAddress}}/api/wills/{{willId}}
Authorization: Bearer {{token}}
Accept: application/json

### Submit: DRAFT -> PENDING_EXECUTOR.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/submit
Authorization: Bearer {{token}}
Accept: application/json

### DMS check-in after submit when DMS is ACTIVE.
POST {{LegacyVault_HostAddress}}/api/wills/{{willId}}/dms/check-in
Authorization: Bearer {{token}}
Accept: application/json

### =========================================================
### OPTIONAL CLEANUP
### Do this only after Will testing, because Will references the Asset.
### =========================================================

# DELETE {{LegacyVault_HostAddress}}/api/assets/{{assetId}}
# Authorization: Bearer {{token}}


### =========================================================
### SPRINT 4 - WALLET / ADMIN OVERSIGHT / AUDIT
### Use an ADMIN JWT for the /api/admin requests.
### =========================================================

### Mock top-up: use a NEW Idempotency-Key for each intended top-up; reuse it only to retry that same request.
POST {{LegacyVault_HostAddress}}/api/wallet/topup
Authorization: Bearer {{token}}
Idempotency-Key: 7f9d67e6-7e89-4d9c-a0a2-9d35e9a6a001
Content-Type: application/json

{
  "amount": 1000000
}

### Admin: list executors (optional ?suspended=true / ?verified=true)
GET {{LegacyVault_HostAddress}}/api/admin/executors
Authorization: Bearer {{token}}
Accept: application/json

### Admin: suspend executor (reason required)
PUT {{LegacyVault_HostAddress}}/api/admin/executors/{{executorAccountId}}/suspension
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isSuspended": true,
  "reason": "Demo suspension for policy review"
}

### Admin: reinstate executor
PUT {{LegacyVault_HostAddress}}/api/admin/executors/{{executorAccountId}}/suspension
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isSuspended": false
}

### Admin: legal case oversight only (does not approve/reject)
GET {{LegacyVault_HostAddress}}/api/admin/legal-cases?status=PENDING
Authorization: Bearer {{token}}
Accept: application/json

### Admin: payments + associated wallet ledger
GET {{LegacyVault_HostAddress}}/api/admin/payments?page=1&pageSize=50
Authorization: Bearer {{token}}
Accept: application/json

### Admin: searchable audit trail
GET {{LegacyVault_HostAddress}}/api/admin/audit-logs?page=1&pageSize=50
Authorization: Bearer {{token}}
Accept: application/json


### Owner or assigned Executor: open one dispute while fee is HELD
POST {{LegacyVault_HostAddress}}/api/wallet/disputes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "willId": "{{willId}}",
  "reason": "The agreed handover scope needs review."
}

### My payment disputes
GET {{LegacyVault_HostAddress}}/api/wallet/disputes/mine
Authorization: Bearer {{token}}
Accept: application/json

### Admin: list open payment disputes
GET {{LegacyVault_HostAddress}}/api/admin/payment-disputes?status=OPEN
Authorization: Bearer {{token}}
Accept: application/json

### Admin: resolve dispute by refund (or use RELEASE only after HANDED_OVER)
POST {{LegacyVault_HostAddress}}/api/admin/payment-disputes/PASTE_DISPUTE_ID_HERE/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "REFUND",
  "note": "Reviewed the dispute; refund approved."
}

### ===== Sprint 4 completion (H06 / E10 / W09 / audit) =====

### H06 Admin: pause an unfinished handover (a dispute pauses it automatically)
POST {{LegacyVault_HostAddress}}/api/handover/{{willId}}/pause
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Executor reported a problem with one item."
}

### H06 Admin: resume a paused handover (refused while a dispute is OPEN)
POST {{LegacyVault_HostAddress}}/api/handover/{{willId}}/resume
Authorization: Bearer {{token}}

### H06 revise: Admin sends a delivered item back to PENDING (handover must be PAUSED)
POST {{LegacyVault_HostAddress}}/api/handover/items/PASTE_ITEM_ID_HERE/reopen
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Beneficiary did not receive the asset."
}

### H06 reassign: Admin picks another executor (will ACTIVE or handover PAUSED)
POST {{LegacyVault_HostAddress}}/api/handover/{{willId}}/reassign-executor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newExecutorAccountId": "PASTE_EXECUTOR_ACCOUNT_ID_HERE",
  "reason": "Previous executor is unresponsive."
}

### H06 Admin: resolve a dispute. action = REFUND | RELEASE | RESUME | REASSIGN
POST {{LegacyVault_HostAddress}}/api/admin/payment-disputes/PASTE_DISPUTE_ID_HERE/resolve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "REASSIGN",
  "note": "Moving the case to a different executor.",
  "newExecutorAccountId": "PASTE_EXECUTOR_ACCOUNT_ID_HERE"
}

### E10 Reference price (platform data only, not a market price)
GET {{LegacyVault_HostAddress}}/api/executors/pricing-reference
Authorization: Bearer {{token}}
Accept: application/json

### W09 My relationships (owner / beneficiary / executor, scoped to the caller)
GET {{LegacyVault_HostAddress}}/api/relationships/me
Authorization: Bearer {{token}}
Accept: application/json

### W09 Owner: where one of my assets is used and who receives it
GET {{LegacyVault_HostAddress}}/api/relationships/assets/{{assetId}}
Authorization: Bearer {{token}}
Accept: application/json

### AD09 Audit log (look for WILL_*, EXECUTOR_*, DMS_*, HANDOVER_*, PAYMENT_* actions)
GET {{LegacyVault_HostAddress}}/api/admin/audit-logs?pageSize=50
Authorization: Bearer {{token}}
Accept: application/json
