{
  "baseUrl": "https://localhost:7080",
  "maskSecrets": false,
  "steps": [
    {
      "name": "Register alice",
      "group": "Register",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-alice.txt",
      "expectStatus": 201,
      "expectBodyContains": [
        "\"username\":\"alice{{runId}}\"",
        "\"role\":\"OWNER\""
      ],
      "expectBodyNotContains": [
        "passwordHash",
        "secretOtp"
      ]
    },
    {
      "name": "Register alice again (duplicate)",
      "group": "Register",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-alice.txt",
      "expectStatus": 409
    },
    {
      "name": "Register with role ADMIN is forbidden",
      "group": "Register",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-admin-role.txt",
      "expectStatus": 403
    },
    {
      "name": "Register with weak password",
      "group": "Register",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-weak-password.txt",
      "expectStatus": 400
    },
    {
      "name": "Password 7 chars (too short)",
      "group": "Password rules",
      "description": "A password one character below the minimum of 8. Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-too-short.txt",
      "expectStatus": 400,
      "expectBodyContains": [
        "Password must be 8-100 chars"
      ]
    },
    {
      "name": "Password without a digit",
      "group": "Password rules",
      "description": "8+ letters but no digit. Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-no-digit.txt",
      "expectStatus": 400,
      "expectBodyContains": [
        "Password must be 8-100 chars"
      ]
    },
    {
      "name": "Password without a letter",
      "group": "Password rules",
      "description": "8+ digits but no letter. Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-no-letter.txt",
      "expectStatus": 400,
      "expectBodyContains": [
        "Password must be 8-100 chars"
      ]
    },
    {
      "name": "Password 101 chars (too long)",
      "group": "Password rules",
      "description": "One character above the maximum of 100. Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-too-long.txt",
      "expectStatus": 400,
      "expectBodyContains": [
        "Password must be 8-100 chars"
      ]
    },
    {
      "name": "Password exactly 8 chars is accepted",
      "group": "Password rules",
      "description": "Shortest allowed password (8 chars, letter + digit). Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-min-ok.txt",
      "expectStatus": 201,
      "expectBodyContains": [
        "\"username\":\"pwmin{{runId}}\""
      ]
    },
    {
      "name": "Password exactly 100 chars is accepted",
      "group": "Password rules",
      "description": "Longest allowed password (100 chars). Rule reported by the API: 8-100 chars, at least one letter and one digit.",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-pw-max-ok.txt",
      "expectStatus": 201,
      "expectBodyContains": [
        "\"username\":\"pwmax{{runId}}\""
      ]
    },
    {
      "name": "Register bob",
      "group": "Register",
      "method": "POST",
      "path": "/api/auth/register",
      "bodyFile": "bodies/register-bob.txt",
      "expectStatus": 201
    },
    {
      "name": "Login with wrong password",
      "group": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "bodyFile": "bodies/login-wrong-password.txt",
      "expectStatus": 401
    },
    {
      "name": "Login alice by username",
      "group": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "bodyFile": "bodies/login-alice.txt",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"tokenType\":\"Bearer\""
      ],
      "capture": {
        "aliceToken": "accessToken",
        "aliceId": "account.id"
      }
    },
    {
      "name": "Login alice by email",
      "group": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "bodyFile": "bodies/login-alice-email.txt",
      "expectStatus": 200
    },
    {
      "name": "Login bob",
      "group": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "bodyFile": "bodies/login-bob.txt",
      "expectStatus": 200,
      "capture": {
        "bobToken": "accessToken",
        "bobId": "account.id"
      }
    },
    {
      "name": "Login seeded admin",
      "group": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "bodyFile": "bodies/login-admin.txt",
      "expectStatus": 200,
      "capture": {
        "adminToken": "accessToken",
        "adminId": "account.id"
      }
    },
    {
      "name": "GET me (alice)",
      "group": "Profile",
      "method": "GET",
      "path": "/api/accounts/me",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"emailVerified\":false",
        "\"phoneVerified\":false",
        "\"identityStatus\":\"NONE\""
      ]
    },
    {
      "name": "GET me without token",
      "group": "Profile",
      "method": "GET",
      "path": "/api/accounts/me",
      "expectStatus": 401
    },
    {
      "name": "Send email OTP",
      "group": "Email OTP",
      "method": "POST",
      "path": "/api/auth/send-email-otp",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "capture": {
        "emailOtp": "devCode"
      }
    },
    {
      "name": "Verify email OTP with wrong code",
      "group": "Email OTP",
      "method": "POST",
      "path": "/api/auth/verify-email-otp",
      "bodyFile": "bodies/otp-wrong-code.txt",
      "bearer": "aliceToken",
      "expectStatus": 400
    },
    {
      "name": "Verify email OTP",
      "group": "Email OTP",
      "method": "POST",
      "path": "/api/auth/verify-email-otp",
      "bodyFile": "bodies/verify-email-otp.txt",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"emailVerified\":true"
      ]
    },
    {
      "name": "Send email OTP again (already verified)",
      "group": "Email OTP",
      "method": "POST",
      "path": "/api/auth/send-email-otp",
      "bearer": "aliceToken",
      "expectStatus": 409
    },
    {
      "name": "PUT me (change full name)",
      "group": "Update profile",
      "method": "PUT",
      "path": "/api/accounts/me",
      "bodyFile": "bodies/update-profile.txt",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "Alice N. Updated"
      ]
    },
    {
      "name": "Identity verify before phone is verified",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "bodyFile": "bodies/identity-ok.txt",
      "bearer": "aliceToken",
      "expectStatus": 400
    },
    {
      "name": "Send phone OTP",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/send-phone-otp",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "capture": {
        "phoneOtp": "devCode"
      }
    },
    {
      "name": "Verify phone",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/verify-phone",
      "bodyFile": "bodies/verify-phone-otp.txt",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"phoneVerified\":true"
      ]
    },
    {
      "name": "Identity verify (mock provider rejects FAIL*)",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "bodyFile": "bodies/identity-rejected.txt",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"status\":\"REJECTED\""
      ]
    },
    {
      "name": "Identity verify (accepted)",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "bodyFile": "bodies/identity-ok.txt",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"status\":\"VERIFIED\"",
        "\"externalIdentityId\":\"EXT-"
      ],
      "capture": {
        "aliceExternalId": "externalIdentityId"
      }
    },
    {
      "name": "Identity verify again (already verified)",
      "group": "Phone OTP + identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "bodyFile": "bodies/identity-ok.txt",
      "bearer": "aliceToken",
      "expectStatus": 409
    },
    {
      "name": "GET me shows VERIFIED",
      "group": "Phone OTP + identity",
      "method": "GET",
      "path": "/api/accounts/me",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"identityStatus\":\"VERIFIED\"",
        "\"externalIdentityId\":\"{{aliceExternalId}}\""
      ]
    },
    {
      "name": "Search by email (non-admin gets summary only)",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?email=bob{{runId}}@test.local",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"username\":\"bob{{runId}}\""
      ],
      "expectBodyNotContains": [
        "\"email\"",
        "\"phone\""
      ]
    },
    {
      "name": "Search by phone",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?phone=%2B84902{{runId}}",
      "bearer": "aliceToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"username\":\"bob{{runId}}\""
      ]
    },
    {
      "name": "Search with no parameter",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search",
      "bearer": "aliceToken",
      "expectStatus": 400
    },
    {
      "name": "Search with both parameters",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?email=a@b.com&phone=0900000000",
      "bearer": "aliceToken",
      "expectStatus": 400
    },
    {
      "name": "Search unknown email",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?email=nobody{{runId}}@test.local",
      "bearer": "aliceToken",
      "expectStatus": 404
    },
    {
      "name": "Search without token",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?email=bob{{runId}}@test.local",
      "expectStatus": 401
    },
    {
      "name": "Search by email as admin (full record)",
      "group": "Search",
      "method": "GET",
      "path": "/api/accounts/search?email=bob{{runId}}@test.local",
      "bearer": "adminToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"email\":\"bob{{runId}}@test.local\"",
        "\"phone\":\"+84902{{runId}}\""
      ]
    },
    {
      "name": "Non-admin cannot change roles",
      "group": "Role authorization",
      "method": "PUT",
      "path": "/api/accounts/{{aliceId}}/role",
      "bodyFile": "bodies/change-role-legal-verifier.txt",
      "bearer": "bobToken",
      "expectStatus": 403
    },
    {
      "name": "Admin changes bob's role",
      "group": "Role authorization",
      "method": "PUT",
      "path": "/api/accounts/{{bobId}}/role",
      "bodyFile": "bodies/change-role-legal-verifier.txt",
      "bearer": "adminToken",
      "expectStatus": 200,
      "expectBodyContains": [
        "\"role\":\"LEGAL_VERIFIER\""
      ]
    },
    {
      "name": "Admin cannot change own role",
      "group": "Role authorization",
      "method": "PUT",
      "path": "/api/accounts/{{adminId}}/role",
      "bodyFile": "bodies/change-role-self.txt",
      "bearer": "adminToken",
      "expectStatus": 400
    },
    {
      "name": "Admin changes role of unknown id",
      "group": "Role authorization",
      "method": "PUT",
      "path": "/api/accounts/00000000-0000-0000-0000-000000000001/role",
      "bodyFile": "bodies/change-role-legal-verifier.txt",
      "bearer": "adminToken",
      "expectStatus": 404
    }
  ]
}
