<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web UI is embedded so the tool stays a single self-contained build. -->
    <EmbeddedResource Include="ui\index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
